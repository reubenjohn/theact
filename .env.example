# LLM API configuration — works with any OpenAI-compatible endpoint
#
# Popular providers:
#   OpenAI:         https://platform.openai.com      (API keys at platform.openai.com/api-keys)
#   OpenRouter:     https://openrouter.ai             (API keys at openrouter.ai/settings/keys)
#   Together AI:    https://www.together.ai           (API keys at api.together.ai/settings/api-keys)
#   Groq:           https://console.groq.com          (API keys at console.groq.com/keys)
#   Local (Ollama): http://localhost:11434/v1          (no key needed, use "ollama")
#   Venice AI:      https://venice.ai                (API keys at venice.ai/settings/api)
#   Local (vLLM):   http://localhost:8000/v1           (no key needed, use "vllm")

# Required
LLM_API_KEY=your_api_key_here

# Required — set to your provider's base URL
LLM_BASE_URL=https://api.openai.com/v1

# Required — model name as accepted by your provider
# Examples:
#   OpenAI:       gpt-4o-mini
#   OpenRouter:   meta-llama/llama-3.1-8b-instruct
#   Together AI:  meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
#   Groq:         llama-3.1-8b-instant
#   Venice AI:    (your Venice model name)
#   Ollama:       llama3.1:8b
LLM_MODEL=your_model_name_here

# Data directory — games/ and saves/ live here instead of the project root
# THEACT_DATA_DIR=/path/to/my/data

# Game Creation Agent (RECOMMENDED — uses a more capable model than gameplay)
# Without these, the creator falls back to LLM_* settings and whatever model
# you configured above. Game creation works best with a large capable model.
# Set at least CREATOR_MODEL to a strong model for best results.
# CREATOR_API_KEY=sk-...                     # Required if using a different provider
# CREATOR_BASE_URL=https://api.openai.com/v1
# CREATOR_MODEL=gpt-4o                       # Or: claude-sonnet-4-20250514, etc.
